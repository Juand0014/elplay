{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@elplay/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@elplay/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@elplay/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@elplay/db": [
        "../../packages/db/types.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
